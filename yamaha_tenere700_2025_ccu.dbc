CM_ "ENTIRE FILE IS A HYPOTHESIS CATALOG. Not OEM ground truth. Passive signals from short listen-only captures. Road validation pending.";
CM_ BO_ 636 "HYP/OBS: RPM scale ~0.4 (~R9 100/256). Gear nibble 0=N..6, 7=between is stronger hyp (R9). Other bits weaker.";
CM_ BO_ 675 "PLACEHOLDER: nearly fixed when stopped. Meaning unknown until riding.";
CM_ BO_ 899 "HYP/CONFLICT: speed vs brake-bit (R9). Mostly fixed when stopped.";
CM_ BO_ 1298 "CONFLICT: B0/B1 often match coolant/IAT (raw*0.625-30). Old sync-counter story demoted.";
CM_ SG_ 1298 Hyp_B0_TempOrCounter "Prefer temperature hyp until proven otherwise; factor 0.625 offset -30 is R9-compatible.";
CM_ SG_ 1298 Hyp_B1_IATOrField "Same scale as B0 under temperature hyp.";
CM_ BO_ 1418 "HYP: Y-Connect clock sync. All-zero may mean unsynced.";
CM_ BO_ 1425 "HYP: phone/Y-Connect session.";
CM_ BO_ 1434 "HYP: navi/notification UTF-8 multi-frame.";
CM_ BO_ 1872 "HYP/CONFLICT: fuel-flow claim is weak; R9 points at RPM hundreds / throttle coarse.";
CM_ BO_ 1873 "HYP/CONFLICT: warmup-timer claim is weak; R9 points at neutral/clutch/stand in B6.";
CM_ BO_ 1878 "HYP/CONFLICT: injection-rate claim is weak; R9 rear wheel speed when moving.";
CM_ BO_ 1879 "HYP: lighting / high-beam candidate only.";
CM_ BO_ 1880 "HYP/CONFLICT: env-sensor claim demoted; APS/TPS (throttle) hyp is stronger from blip logs / R9.";
CM_ BO_ 1881 "HYP: commanded throttle candidate (R9).";
CM_ BO_ 1889 "PLACEHOLDER: needs road test.";
CM_ BO_ 1890 "PLACEHOLDER: needs road test.";
CM_ BO_ 2016 "OBS: UDS requests from CCU (multiple services; not a fixed 0.5s-only poll).";
CM_ BO_ 2024 "OBS: UDS responses. Fuel-counter / injector-PW byte mapping remains HYP.";

VAL_ 636 Hyp_Gear_Nibble 0 "N_or_unknown" 1 "Gear1_hyp" 2 "Gear2_hyp" 3 "Gear3_hyp" 4 "Gear4_hyp" 5 "Gear5_hyp" 6 "Gear6_hyp" 7 "Between_hyp" ;
